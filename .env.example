# ==============================================================================
# FairTab Environment Variables Template
# Copy this file to .env and fill in your actual credentials:
#   cp .env.example .env
# NOTE: .env is in .gitignore so your real secrets will never be pushed to GitHub.
# ==============================================================================

# Gemini AI API Key (Required for AI receipt scanning, voice NLP, insights)
GEMINI_API_KEY=""

# Application Host URL (Injected by runtime or localhost)
APP_URL="http://localhost:3000"

# Cloud SQL / PostgreSQL Database Connection (Used by application server)
SQL_HOST=""
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""

# Cloud SQL Admin Credentials (Used by drizzle-kit for database migrations)
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
